{
  "name": "rapid-medical",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "tsx --env-file=.env scripts/seed.ts --reset",
    "duda:scrape": "tsx scripts/scrape-duda.ts",
    "duda:extract": "tsx scripts/extract-duda.ts",
    "duda:media": "tsx --env-file=.env scripts/migrate-media.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run duda:media"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
