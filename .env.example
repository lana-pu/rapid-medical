# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rapid_medical

# Secret for signing admin session cookies (32+ random chars)
AUTH_SECRET=change-me-to-a-long-random-string

# Public site URL (used for canonical links, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host ports used by `docker compose up` (change if 3000 / 5432 are taken)
APP_PORT=3000
DB_PORT=5432

# Where uploaded media is stored: "local" (public/uploads) or "s3"
STORAGE_DRIVER=local
# S3-compatible storage (only if STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Outgoing email for form notifications (SMTP). Leave empty to log to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rapid Medical Website <no-reply@rapid-medical.com>"
MAIL_TO=info@rapid-medical.com

# Protects /api/cron/publish (scheduled publishing). Vercel sets the header automatically for its crons.
CRON_SECRET=
